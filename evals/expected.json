{
  "schema_version": 1,
  "description": "Hand-checked expected quote records for fictional supplier emails in evals/emails/. All suppliers, parts, and prices are invented.",
  "rules": {
    "records": "One record per offer a buyer could accept on its own. An email with no offer has zero records.",
    "quantity": "Units in stock now. Units in repair or 'available later' are not counted.",
    "unit_price": "Price per unit as a two-decimal string, never a float. If the email gives a lot total, divide by quantity.",
    "unknown": "A field the email does not state is null. Never infer it (e.g. no currency symbol -> currency null).",
    "condition": "OH = overhauled, SV = serviceable (incl. Inspected/Tested), NE = new. As-removed/untested or unstated -> null.",
    "core_charge": "Amount owed only if the exchange core is not returned or is BER. Two-decimal string; null for outright offers.",
    "split": "dev cases may be used while writing prompts; held_out cases are scored only, never used to tune prompts."
  },
